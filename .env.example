# ─── Core ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git.

# ─── Appium / Android ──────────────────────────────────────────────────────────
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_PLATFORM_VERSION=13
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_APP_PATH=/path/to/your-app.apk
# OR use package + activity instead of APK path:
ANDROID_APP_PACKAGE=com.example.myapp
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_AUTOMATION_NAME=UiAutomator2
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20

# ─── Web / Selenium ────────────────────────────────────────────────────────────
BROWSER=chrome          # chrome | firefox
HEADLESS=false          # true for CI/Jenkins, false for local dev
BASE_URL=https://example.com

# ─── API ───────────────────────────────────────────────────────────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT=30
API_TOKEN=              # Bearer token if required
